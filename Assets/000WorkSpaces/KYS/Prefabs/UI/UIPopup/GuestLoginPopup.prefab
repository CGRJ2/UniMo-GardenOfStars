  confirmText: "\uAC8C\uC2A4\uD2B8\uB85C \uC2DC\uC791"
  cancelText: "\uCDE8\uC18C"
  guestMessage1: "\uAC8C\uC2A4\uD2B8\uB85C \uB85C\uADF8\uC778\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
